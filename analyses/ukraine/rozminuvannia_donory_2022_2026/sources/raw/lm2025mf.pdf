This page could not be found.</h2></div></div></article></main><div
class="py-12 bg-white text-black/85 border-t border-gray-300/50"><footer
class="container layout-base gap-y-layoutGap"><div
class="no-js:hidden col-main md:col-main-halfLeft text-sm"
x-data="{
csrf: null,
isSubmitting: null,
email: '',
isSuccess: null,
message: null,
}"
><h3 class="mb-2 font-mediumTitle text-4xl">
Let’s stay in touch</h3><p
class="mb-8 text-base">
Subscribe to updates about ICBL–CMC&#039;s impact around the world</p><form
class="flex flex-col sm:flex-row gap-5 sm:gap-7 mb-8"
method="post"
x-on:focusin="
if (!csrf) {
csrf = fetch('https://the-monitor.org/csrf.json')
.then(r => r.json())
.then(r => $el.insertAdjacentHTML('afterbegin', r.input))
}
"
x-on:submit.prevent="
isSubmitting = true;
csrf
.then((_) => {
data = new FormData($el);
data.append('email', email);
return fetch('https://the-monitor.org/mailchimp/send', {
method: 'post',
body: data,
})
})
.then(r => r.json())
.then(status => {
isSubmitting = false;
isSuccess = status.success;
message = status.msg;
})
"
><div
class="flex flex-col gap-2 grow sm:max-w-3/5">
<label
for="newsletter-email" class="sr-only">
Email address
</label>
<input
type="email" id="newsletter-email" class="px-3 py-1.5 text-base leading-large placeholder:text-gray-400 rounded-md border border-gray-400 focus:outline-red-600 focus:outline readonly:border-gray-100 readonly:cursor-not-allowed" name="email" required placeholder="Your email address *" x-model="email" x-bind:readonly="isSubmitting"><p
x-show="message"
x-transition
x-text="message"
x-bind:class="{
'text-green-700': isSuccess,
'text-red-600': !isSuccess,
}"
